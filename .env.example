# Copy to .env and fill in — .env is gitignored, never commit it.
#
#   cp .env.example .env
#
# The Express dev server (server/index.js) reads .env from the repo root.
# On Vercel these are set under Project Settings → Environment Variables
# instead, and the api/ functions pick them up from there.


# ── Contact form (required for the form to send) ────────────────────────────
# The form 500s without SMTP_USER and SMTP_PASS; the rest have defaults.
# For Gmail this must be an App Password, not the account password —
# generate one at https://myaccount.google.com/apppasswords with 2FA on.

SMTP_HOST=          # optional, defaults to smtp.gmail.com
SMTP_PORT=          # optional, defaults to 587
SMTP_USER=          # required — the sending mailbox, e.g. you@gmail.com
SMTP_PASS=          # required — app password, NOT your login password
CONTACT_TO=         # optional, where messages land; defaults to SMTP_USER


# ── GitHub activity section ─────────────────────────────────────────────────
# Both are optional. Without a token the section still renders: it falls back
# to github-contributions-api.jogruber.de, which serves PUBLIC contributions
# only. Set a token to include private-repo contributions via the GraphQL API.
# A classic PAT with `read:user` is enough — it needs no repo scope.

GITHUB_USERNAME=    # optional, defaults to jayveedev-alt
GITHUB_TOKEN=       # optional — omit for public-only counts


# ── Local Express server only (ignored on Vercel) ───────────────────────────

PORT=               # optional, defaults to 3001
CLIENT_ORIGIN=      # optional, CORS origin; defaults to http://localhost:5173
